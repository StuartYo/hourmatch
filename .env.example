# Never put real values in a file. Set these as user environment variables.
# LLM (OpenAI-compatible). Default endpoint: PublicAI free inference (Apertus).
LLM_API_KEY=
LLM_BASE_URL=https://api.publicai.co/v1
LLM_MODEL=swiss-ai/apertus-70b-instruct
# Testnet-only deployer key (Base Sepolia / Sepolia). No mainnet, no real money.
CLIMATECHAIN_TESTNET_PK=
