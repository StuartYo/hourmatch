LLM_API_KEY=
LLM_BASE_URL=https://api.publicai.co/v1
LLM_MODEL=aisingapore/Qwen-SEA-LION-v4-32B-IT
# Testnet-only operator key (Ethereum Sepolia, chain id 11155111), as a user environment variable.
CLIMATECHAIN_TESTNET_PK=
